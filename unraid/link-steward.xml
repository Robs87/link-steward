<?xml version="1.0"?>
<Container version="2">
  <Name>Link Steward OneNav Fork</Name>
  <Repository>ghcr.io/robs87/link-steward:latest</Repository>
  <Registry>https://github.com/Robs87/link-steward/pkgs/container/link-steward</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Robs87/link-steward</Support>
  <Project>https://github.com/Robs87/link-steward</Project>
  <Overview>Apache-2.0 compliant fork of OneNav packaged for Unraid. OneNav is a PHP + SQLite bookmark/navigation manager.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:3088]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Robs87/link-steward/main/unraid/link-steward.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/Robs87/link-steward/main/favicon.ico</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI Port" Target="80" Default="3088" Mode="tcp" Description="Web UI port. Container listens on port 80." Type="Port" Display="always" Required="true" Mask="false">3088</Config>
  <Config Name="App Data" Target="/var/www/html/data" Default="/mnt/user/appdata/link-steward" Mode="rw" Description="Persistent OneNav config, SQLite database, uploads, themes, and backups." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/link-steward</Config>
</Container>
